{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "JR 大阪站 · 启动服务",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev.ts",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "JR 大阪站 · 预览服务",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev.ts",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PORT": "5173"
      },
      "skipFiles": ["<node_internals>/**"],
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "JR 大阪站 · 预览 Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "地图：等待预览服务就绪",
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "JR 大阪站 · 本地预览",
      "configurations": ["JR 大阪站 · 预览服务", "JR 大阪站 · 预览 Chrome"],
      "stopAll": true
    }
  ]
}
